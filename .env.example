# Tavus (https://docs.tavus.io) — server-side only, never exposed to the browser
TAVUS_API_KEY=
# Optional: a Tavus face id (formerly "replica id"). Otherwise a stock face is auto-selected.
TAVUS_DEFAULT_REPLICA_ID=

# Anthropic (optional) — enables the written post-interview scorecard. Leave empty to skip it:
# interviews then end on a completion screen and the interviewer's spoken debrief is the feedback.
ANTHROPIC_API_KEY=

# Public base URL of this app. Webhooks and knowledge-base documents are only
# registered with Tavus when this is a public https URL (not localhost).
APP_BASE_URL=http://localhost:3000

# Optional shared secret appended to the Tavus callback URL (?token=...) and
# verified by /api/webhooks/tavus. Tavus does not sign conversation callbacks.
TAVUS_WEBHOOK_SECRET=
